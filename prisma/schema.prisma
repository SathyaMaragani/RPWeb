generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  characters       Character[]
  worldMembers     WorldMember[]
  worldsOwned      World[]       @relation("WorldOwner")
  authoredMessages Message[]     @relation("MessageAuthor")
  personas         Persona[]
  modelPresets     ModelPreset[]
}

/// A saved way to reach a model with the user's own API key ("bring your own
/// key"). The key is encrypted at rest and never sent back to the browser.
model ModelPreset {
  id          String   @id @default(cuid())
  userId      String
  name        String
  /// Key into PROVIDERS in src/lib/ai/providers.ts.
  provider    String
  /// Only for the "custom" provider; the others have fixed endpoints.
  baseUrl     String?
  model       String
  apiKeyEnc   String
  /// Last four characters of the key, so the user can tell keys apart.
  keyHint     String
  temperature Float    @default(0.9)
  maxTokens   Int      @default(800)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Who the user is inside a roleplay. An AI character is told about the active
/// persona, so it knows who it is talking to.
model Persona {
  id          String   @id @default(cuid())
  userId      String
  name        String
  avatarUrl   String?
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Character {
  id              String    @id @default(cuid())
  /// Who created it. Not who may use it — that follows from the world's cast.
  userId          String
  name            String
  /// An externally hosted image. Used when no avatar has been uploaded.
  avatarUrl       String?
  /// Set when an uploaded avatar exists. Doubles as the cache-busting version
  /// for the image route, so the bytes can be served as immutable.
  avatarUpdatedAt DateTime?
  bio             String?
  /// Accent colour as #rrggbb. Falls back to a hue derived from the id.
  color           String?
  title           String?
  /// A designed look: which catalogue asset fills each slot, in which colours.
  /// The configuration is the source of truth; pictures are drawn from it.
  appearance      Json?
  /// Set whenever the design is saved. Versions the portrait URL, and decides
  /// between the design and an uploaded avatar: whichever is newer shows.
  appearanceUpdatedAt DateTime?

  // Character card: what an AI needs to play this character. All optional,
  // so characters made before cards existed are untouched.
  personality     String?
  scenario        String?
  /// The opening message an AI-played character starts a chat with.
  greeting        String?
  /// Sample exchanges showing how they talk. Blocks separated by <START>.
  exampleDialogue String?
  tags            String[]  @default([])
  /// PRIVATE, UNLISTED or PUBLIC. Only affects discovery, not world access.
  visibility      String    @default("PRIVATE")
  /// Lore that travels with the character, usually from an imported card.
  /// Used whenever the character is AI-played, in any world. A list of
  /// entries shaped like LoreEntry (name, keywords, content, flags).
  lorebook        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldMembers WorldMember[]
  messages     Message[]
  worlds       WorldCharacter[]
  avatar       CharacterAvatar?
}

/// Uploaded avatar bytes, kept out of Character on purpose: every message query
/// includes its character, and a Bytes column there would drag the image into
/// each one. Read only by the image route.
model CharacterAvatar {
  characterId String   @id
  data        Bytes
  mime        String
  updatedAt   DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model World {
  id              String    @id @default(cuid())
  name            String
  description     String?
  /// An externally hosted banner. Used when none has been uploaded.
  bannerUrl       String?
  /// Set when an uploaded banner exists; doubles as the cache-busting version.
  bannerUpdatedAt DateTime?
  inviteCode      String    @unique
  ownerId         String
  /// Notes every AI reply in this world is given: facts to keep consistent.
  memory          String?
  /// Replaces the default instructions AI characters are given here.
  systemPrompt    String?
  /// Rolling "story so far" for AI replies, covering messages too old to fit
  /// in a prompt. Written by the model, editable by members.
  summary         String?
  /// Timestamp of the last message folded into `summary`.
  summaryUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner    User             @relation("WorldOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  WorldMember[]
  messages Message[]
  imports  TelegramImport[]
  cast     WorldCharacter[]
  banner   WorldBanner?
  lore     LoreEntry[]
}

/// Uploaded banner bytes. Separate from World for the same reason avatars are
/// separate from Character: worlds are loaded on pages that have no use for the
/// image, and a Bytes column would come along with every one.
model WorldBanner {
  worldId   String   @id
  data      Bytes
  mime      String
  updatedAt DateTime @updatedAt

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
}

/// The characters belonging to a world. Every member may write as any of them,
/// so a shared story does not fracture into one private cast per person — which
/// is how a world ended up with two separate characters both called "Gold".
model WorldCharacter {
  id          String   @id @default(cuid())
  worldId     String
  characterId String
  /// Whether an AI writes this character's replies in this world.
  aiEnabled   Boolean  @default(false)
  addedAt     DateTime @default(now())

  world     World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([worldId, characterId])
  @@index([worldId])
}

model WorldMember {
  id          String   @id @default(cuid())
  worldId     String
  userId      String
  characterId String
  joinedAt    DateTime @default(now())
  role        String   @default("MEMBER") // OWNER, MEMBER

  world     World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([worldId, userId])
}

model Message {
  id          String    @id @default(cuid())
  worldId     String
  characterId String
  /// Who typed it. With a shared cast, owning the character no longer implies
  /// having written the line. Null for imported and pre-cast messages.
  authorId    String?
  content     String
  format      String    @default("NARRATION") // ACTION, DIALOGUE, THOUGHT, NARRATION
  timestamp   DateTime  @default(now())
  isImported  Boolean   @default(false)
  /// Written by a model rather than typed by a person.
  aiGenerated Boolean   @default(false)
  /// Every version of an AI reply, when it has been regenerated. `content`
  /// always mirrors swipes[swipeIndex], so nothing else needs to know.
  swipes      String[]  @default([])
  swipeIndex  Int       @default(0)
  editedAt    DateTime?
  // Soft delete. Clients learn about new messages by polling for rows changed
  // since a cursor; a hard delete leaves nothing to poll, so the other person
  // would keep seeing a message that no longer exists until they reloaded.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  world     World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  author    User?     @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([worldId, timestamp])
  // Serves the polling query, which asks for everything changed since a cursor.
  @@index([worldId, updatedAt])
}

model TelegramImport {
  id         String   @id @default(cuid())
  worldId    String
  uploadedBy String
  status     String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
}

/// A lorebook entry: world knowledge an AI is only given when it is relevant,
/// meaning when one of its keywords appears in the recent conversation.
/// Keeps prompts short while the world can hold far more detail.
model LoreEntry {
  id            String   @id @default(cuid())
  worldId       String
  name          String
  keywords      String[] @default([])
  content       String
  /// Always included, whatever the conversation says.
  constant      Boolean  @default(false)
  enabled       Boolean  @default(true)
  caseSensitive Boolean  @default(false)
  /// Match "elf" but not "self".
  wholeWord     Boolean  @default(true)
  /// Higher goes in first when there is not room for everything.
  priority      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([worldId])
}
